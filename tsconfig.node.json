{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "./out/tsconfig-node"
  },
  "include": [
    "electron/main/**/*",
    "electron/preload/**/*",
    "scripts/test-preload-bridge.ts",
    "electron.vite.config.ts"
  ],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
