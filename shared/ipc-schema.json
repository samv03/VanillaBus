{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanillabus.local/shared/ipc-schema.json",
  "title": "VanillaBus IPC schema",
  "description": "Electron main ↔ vanillabus-engine contract. Transport is a Unix domain socket carrying 4-byte big-endian length + UTF-8 JSON. Frame timestamps are integer microseconds (ts_us); rate_ms is (Δts_us)/1000 and null until a second sample exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "envelope", "frame", "messages"],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "envelope": {
      "description": "Every framed JSON object uses this envelope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "engine.hello",
            "engine.heartbeat",
            "engine.error",
            "bus.list",
            "bus.open",
            "bus.close",
            "dbc.load",
            "dbc.clear",
            "rx.batch",
            "tx.send",
            "tx.cyclic.start",
            "tx.cyclic.stop"
          ]
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id. Echoed on request/response."
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "frame": {
      "description": "CAN frame object used by rx.batch and tx.* (engine-owned; never parsed in the renderer).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "busId",
        "ifName",
        "can_id",
        "data",
        "dlc",
        "is_eff",
        "is_fd",
        "brs",
        "is_rtr",
        "is_err",
        "dir",
        "ts_us",
        "rate_ms"
      ],
      "properties": {
        "busId": { "type": "string", "description": "Open-bus id from bus.open." },
        "ifName": { "type": "string", "description": "SocketCAN interface name (e.g. vcan0)." },
        "can_id": { "type": "integer", "minimum": 0 },
        "data": {
          "type": "string",
          "description": "Hex payload without spaces (even number of hex digits)."
        },
        "dlc": { "type": "integer", "minimum": 0, "maximum": 64 },
        "is_eff": { "type": "boolean", "description": "Extended (29-bit) identifier." },
        "is_fd": { "type": "boolean" },
        "brs": { "type": "boolean", "description": "CAN FD bit-rate switch." },
        "is_rtr": { "type": "boolean", "description": "Remote transmission request." },
        "is_err": { "type": "boolean", "description": "Error frame." },
        "dir": { "type": "string", "enum": ["rx", "tx"] },
        "ts_us": {
          "type": "integer",
          "description": "Software capture timestamp in microseconds (T5: time.time_ns()/1000)."
        },
        "rate_ms": {
          "description": "Last inter-arrival (Δts_us)/1000 for key (busId, can_id, is_eff). null on the first sample. Not EMA. is_fd is not part of the key until FD is enabled.",
          "type": ["number", "null"]
        },
        "decode": {
          "description": "Optional DBC unpack for this frame. null/absent when no DBC is bound to the busId, the CAN ID is unknown, or decode fails. Unknown IDs still appear as raw frames.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "signals"],
          "properties": {
            "name": {
              "type": "string",
              "description": "DBC message name."
            },
            "signals": {
              "type": "object",
              "description": "Decoded signal name → JSON-safe value (number, string, or boolean).",
              "additionalProperties": {
                "type": ["number", "string", "boolean"]
              }
            },
            "units": {
              "type": "object",
              "description": "Optional signal name → unit string when the DBC defines one.",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine.hello",
        "engine.heartbeat",
        "engine.error",
        "bus.list",
        "bus.open",
        "bus.close",
        "dbc.load",
        "dbc.clear",
        "rx.batch",
        "tx.send",
        "tx.cyclic.start",
        "tx.cyclic.stop"
      ],
      "properties": {
        "engine.hello": {
          "description": "Handshake / identity. Engine emits this on connect; also answers a client engine.hello.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "backends"],
              "properties": {
                "name": { "const": "vanillabus-engine" },
                "version": { "type": "string" },
                "backends": {
                  "type": "array",
                  "items": { "type": "string" },
                  "examples": [["socketcan"]]
                }
              }
            }
          }
        },
        "engine.heartbeat": {
          "description": "Periodic liveness from the engine (~2s).",
          "type": "object",
          "properties": {
            "direction": { "const": "event" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ts_us"],
              "properties": {
                "ts_us": {
                  "type": "integer",
                  "description": "Unix time in microseconds"
                }
              }
            }
          }
        },
        "engine.error": {
          "description": "Engine-reported failure (malformed frame, unknown type, later bus/DBC errors).",
          "type": "object",
          "properties": {
            "direction": { "const": "event" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        },
        "bus.list": {
          "description": "List SocketCAN/vcan interfaces with kind hint and up/down state. Engine-side only.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": { "type": "object", "additionalProperties": false, "properties": {} },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["interfaces"],
              "properties": {
                "interfaces": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "kind", "state"],
                    "properties": {
                      "name": { "type": "string", "examples": ["can0", "vcan0"] },
                      "kind": {
                        "type": "string",
                        "description": "Driver or kind hint (vcan, vxcan, kernel driver, socketcan).",
                        "examples": ["vcan", "socketcan", "mcp251x"]
                      },
                      "state": { "type": "string", "enum": ["up", "down"] }
                    }
                  }
                }
              }
            }
          }
        },
        "bus.open": {
          "description": "Bind a SocketCAN interface that already exists and is UP. Returns busId. Multiple buses may be open at once (one handle per iface). Fails with engine.error if missing, down, or already open (iface_not_found / iface_down / iface_already_open); does not ip link set up. bitrate is optional and ignored for vcan.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "bitrate": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Optional. Ignored for vcan. Not applied via ip link."
                }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["busId"],
              "properties": {
                "busId": { "type": "string" }
              }
            }
          }
        },
        "bus.close": {
          "description": "Close an open SocketCAN bus by busId. Reopen after close is allowed.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["busId"],
              "properties": {
                "busId": { "type": "string" }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        },
        "dbc.load": {
          "description": "Load one DBC file per open busId via cantools. Path must resolve under the project/fixtures allowlist. Failures are engine.error (path_not_allowed, dbc_not_found, dbc_invalid, bus_not_found).",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["busId", "path"],
              "properties": {
                "busId": { "type": "string" },
                "path": {
                  "type": "string",
                  "description": "Absolute or repo-relative path to a .dbc file. Must stay under the project root (fixtures included)."
                }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok", "message_count"],
              "properties": {
                "ok": { "type": "boolean" },
                "message_count": { "type": "integer", "minimum": 0 },
                "catalog": {
                  "type": "array",
                  "description": "Optional DBC message/signal list for the Graph picker. Mux rules stay in the engine unpacker.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "can_id", "signals"],
                    "properties": {
                      "name": { "type": "string" },
                      "can_id": { "type": "integer", "minimum": 0 },
                      "signals": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["name"],
                          "properties": {
                            "name": { "type": "string" },
                            "unit": { "type": "string" },
                            "min": { "type": "number", "description": "Optional DBC minimum (physical)." },
                            "max": { "type": "number", "description": "Optional DBC maximum (physical)." },
                            "initial": { "type": "number", "description": "Optional DBC initial / UI default (physical)." }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "dbc.clear": {
          "description": "Unload the DBC bound to an open busId. Idempotent if none is loaded.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["busId"],
              "properties": {
                "busId": { "type": "string" }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        },
        "rx.batch": {
          "description": "Batched received frames from the engine to main. ≤16 ms or ≤500 frames. T7 may attach optional decode {name, signals, units} when a DBC is bound. Unknown IDs stay raw.",
          "type": "object",
          "properties": {
            "direction": { "const": "event" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frames", "dropped"],
              "properties": {
                "frames": {
                  "type": "array",
                  "maxItems": 500,
                  "items": { "$ref": "#/properties/frame" }
                },
                "dropped": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Cumulative frames dropped (oldest) because the RX queue was full."
                }
              }
            }
          }
        },
        "tx.send": {
          "description": "Send a single frame on an open busId. Raw: can_id + hex data. DBC pack: message + signals (cantools encode using the DBC already loaded for busId). Echoes dir=tx onto rx.batch for Trace.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["busId", "can_id", "data"],
                  "properties": {
                    "busId": { "type": "string", "description": "Open-bus id from bus.open." },
                    "can_id": { "type": "integer", "minimum": 0 },
                    "data": {
                      "type": "string",
                      "description": "Hex payload. Spaces/colons are stripped by the engine."
                    },
                    "dlc": { "type": "integer", "minimum": 0, "maximum": 64 },
                    "is_eff": { "type": "boolean" },
                    "is_rtr": { "type": "boolean" },
                    "is_fd": { "type": "boolean" },
                    "brs": { "type": "boolean" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["busId", "message", "signals"],
                  "properties": {
                    "busId": { "type": "string", "description": "Open-bus id from bus.open." },
                    "message": {
                      "type": "string",
                      "description": "DBC message name. Packed with cantools using the DBC bound to busId."
                    },
                    "signals": {
                      "type": "object",
                      "description": "Physical signal name → value. Engine encodes; renderer does not parse DBC.",
                      "additionalProperties": {
                        "type": ["number", "string", "boolean"]
                      }
                    }
                  }
                }
              ]
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        },
        "tx.cyclic.start": {
          "description": "Start an engine-owned cyclic TX job (raw or DBC pack). DBC jobs pack once at start and repeat the raw frame. Stop with tx.cyclic.stop {job_id}. Period is interval ms; median interval should stay within ±10%.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["busId", "can_id", "data", "period_ms"],
                  "properties": {
                    "busId": { "type": "string", "description": "Open-bus id from bus.open." },
                    "can_id": { "type": "integer", "minimum": 0 },
                    "data": {
                      "type": "string",
                      "description": "Hex payload. Spaces/colons are stripped by the engine."
                    },
                    "period_ms": { "type": "integer", "minimum": 1 },
                    "dlc": { "type": "integer", "minimum": 0, "maximum": 64 },
                    "is_eff": { "type": "boolean" },
                    "is_rtr": { "type": "boolean" },
                    "is_fd": { "type": "boolean" },
                    "brs": { "type": "boolean" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["busId", "message", "signals", "period_ms"],
                  "properties": {
                    "busId": { "type": "string", "description": "Open-bus id from bus.open." },
                    "message": { "type": "string" },
                    "signals": {
                      "type": "object",
                      "additionalProperties": {
                        "type": ["number", "string", "boolean"]
                      }
                    },
                    "period_ms": { "type": "integer", "minimum": 1 }
                  }
                }
              ]
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["job_id"],
              "properties": {
                "job_id": { "type": "string" }
              }
            }
          }
        },
        "tx.cyclic.stop": {
          "description": "Stop an engine-owned cyclic TX job by job_id. bus.close also stops jobs for that busId.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["job_id"],
              "properties": {
                "job_id": { "type": "string" }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
