{
  "name": "vanillabus",
  "productName": "VanillaBus",
  "version": "0.1.0",
    "description": "SocketCAN-first desktop bus monitor (T16 hardening: backpressure, OOM, IPC, restart).",
  "license": "GPL-3.0-or-later",
  "author": "Sam Vinella",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:ipc": "python3 scripts/test-ipc-hello.py",
    "test:bridge": "tsx --test scripts/test-preload-bridge.ts",
    "test:bus": "python3 scripts/test-bus-open.py",
    "test:vendor": "python3 scripts/test-vendor-metadata.py",
    "test:bus-bridge": "tsx --test scripts/test-bus-bridge.ts",
    "test:rx": "python3 scripts/test-rx-batch.py",
    "test:rx-bridge": "tsx --test scripts/test-rx-bridge.ts",
    "test:rate": "python3 scripts/test-rate-ms.py",
    "test:dbc": "python3 scripts/test-dbc-unpack.py",
    "test:dbc-bridge": "tsx --test scripts/test-dbc-bridge.ts",
    "test:shell": "node scripts/test-shell-tabs.mjs",
    "test:trace": "tsx --test scripts/test-trace.ts",
    "test:graph": "tsx --test scripts/test-graph.ts",
    "test:tx": "python3 scripts/test-tx.py",
    "test:tx-dbc": "python3 scripts/test-tx-dbc.py",
    "test:tx-bridge": "tsx --test scripts/test-tx-bridge.ts",
    "test:multibus": "python3 scripts/test-multibus.py && tsx --test scripts/test-multibus.ts",
    "test:smoke": "tsx --test scripts/test-smoke.ts",
    "test:smoke:electron": "bash scripts/smoke-electron.sh",
    "test:m1": "npm run test:smoke && npm run test:smoke:electron",
    "test:harden": "python3 scripts/test-harden.py && tsx --test scripts/test-harden.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtuoso": "^4.18.13",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^37.3.1",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  }
}
