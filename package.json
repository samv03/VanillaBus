{
  "name": "vanillabus",
  "productName": "VanillaBus",
  "version": "0.1.0",
  "description": "SocketCAN-first desktop bus monitor (T8 app shell: Trace / Graph / Transmit).",
  "license": "GPL-3.0-or-later",
  "author": "Sam Vinella",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:ipc": "python3 scripts/test-ipc-hello.py",
    "test:bridge": "tsx --test scripts/test-preload-bridge.ts",
    "test:bus": "python3 scripts/test-bus-open.py",
    "test:bus-bridge": "tsx --test scripts/test-bus-bridge.ts",
    "test:rx": "python3 scripts/test-rx-batch.py",
    "test:rx-bridge": "tsx --test scripts/test-rx-bridge.ts",
    "test:rate": "python3 scripts/test-rate-ms.py",
    "test:dbc": "python3 scripts/test-dbc-unpack.py",
    "test:dbc-bridge": "tsx --test scripts/test-dbc-bridge.ts",
    "test:shell": "node scripts/test-shell-tabs.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^37.3.1",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  }
}
