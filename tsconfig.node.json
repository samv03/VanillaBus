{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "./out/tsconfig-node"
  },
  "include": ["electron/main/**/*", "electron/preload/**/*", "electron.vite.config.ts"]
}
