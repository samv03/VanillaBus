{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanillabus.local/shared/ipc-schema.json",
  "title": "VanillaBus IPC schema",
  "description": "Electron main ↔ vanillabus-engine contract. Transport is a Unix domain socket carrying 4-byte big-endian length + UTF-8 JSON. Frame timestamps are integer microseconds (ts_us); rate_ms is (Δts_us)/1000 and null until a second sample exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "envelope", "frame", "messages"],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "envelope": {
      "description": "Every framed JSON object uses this envelope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "engine.hello",
            "engine.heartbeat",
            "engine.error",
            "bus.list",
            "bus.open",
            "bus.close",
            "dbc.load",
            "dbc.clear",
            "rx.batch",
            "tx.send",
            "tx.cyclic.start",
            "tx.cyclic.stop"
          ]
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id. Echoed on request/response."
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "frame": {
      "description": "CAN frame object used by rx.batch and tx.* (engine-owned; never parsed in the renderer).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_id",
        "data",
        "dlc",
        "is_eff",
        "is_fd",
        "brs",
        "dir",
        "ts_us",
        "rate_ms"
      ],
      "properties": {
        "can_id": { "type": "integer", "minimum": 0 },
        "data": {
          "type": "string",
          "description": "Hex payload without spaces (even number of hex digits)."
        },
        "dlc": { "type": "integer", "minimum": 0, "maximum": 64 },
        "is_eff": { "type": "boolean", "description": "Extended (29-bit) identifier." },
        "is_fd": { "type": "boolean" },
        "brs": { "type": "boolean", "description": "CAN FD bit-rate switch." },
        "dir": { "type": "string", "enum": ["rx", "tx"] },
        "ts_us": {
          "type": "integer",
          "description": "Hardware or capture timestamp in microseconds."
        },
        "rate_ms": {
          "description": "(Δts_us)/1000 for the same can_id. null until a second sample exists.",
          "type": ["number", "null"]
        }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine.hello",
        "engine.heartbeat",
        "engine.error",
        "bus.list",
        "bus.open",
        "bus.close",
        "dbc.load",
        "dbc.clear",
        "rx.batch",
        "tx.send",
        "tx.cyclic.start",
        "tx.cyclic.stop"
      ],
      "properties": {
        "engine.hello": {
          "description": "Handshake / identity. Engine emits this on connect; also answers a client engine.hello.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "backends"],
              "properties": {
                "name": { "const": "vanillabus-engine" },
                "version": { "type": "string" },
                "backends": {
                  "type": "array",
                  "items": { "type": "string" },
                  "examples": [["socketcan"]]
                }
              }
            }
          }
        },
        "engine.heartbeat": {
          "description": "Periodic liveness from the engine (~2s).",
          "type": "object",
          "properties": {
            "direction": { "const": "event" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ts_us"],
              "properties": {
                "ts_us": {
                  "type": "integer",
                  "description": "Unix time in microseconds"
                }
              }
            }
          }
        },
        "engine.error": {
          "description": "Engine-reported failure (malformed frame, unknown type, later bus/DBC errors).",
          "type": "object",
          "properties": {
            "direction": { "const": "event" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        },
        "bus.list": {
          "description": "List SocketCAN (and later adapter) interfaces. Engine-side only.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": { "type": "object", "additionalProperties": false, "properties": {} },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["interfaces"],
              "properties": {
                "interfaces": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string", "examples": ["can0", "vcan0"] }
                    }
                  }
                }
              }
            }
          }
        },
        "bus.open": {
          "description": "Open a CAN interface in the engine. Not implemented in T2.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string" }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        },
        "bus.close": {
          "description": "Close the currently open CAN interface. Not implemented in T2.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": { "type": "object", "additionalProperties": false, "properties": {} },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        },
        "dbc.load": {
          "description": "Load a DBC file in the engine (never in the renderer). Not implemented in T2.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string" }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" },
                "message_count": { "type": "integer" }
              }
            }
          }
        },
        "dbc.clear": {
          "description": "Unload any DBC loaded in the engine. Not implemented in T2.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": { "type": "object", "additionalProperties": false, "properties": {} },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        },
        "rx.batch": {
          "description": "Batched received frames from the engine to main. Not emitted in T2.",
          "type": "object",
          "properties": {
            "direction": { "const": "event" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frames"],
              "properties": {
                "frames": {
                  "type": "array",
                  "items": { "$ref": "#/properties/frame" }
                }
              }
            }
          }
        },
        "tx.send": {
          "description": "Send a single frame via the engine. Not implemented in T2.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["can_id", "data"],
              "properties": {
                "can_id": { "type": "integer", "minimum": 0 },
                "data": { "type": "string" },
                "dlc": { "type": "integer", "minimum": 0, "maximum": 64 },
                "is_eff": { "type": "boolean" },
                "is_fd": { "type": "boolean" },
                "brs": { "type": "boolean" }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        },
        "tx.cyclic.start": {
          "description": "Start a cyclic transmit job in the engine. Not implemented in T2.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["can_id", "data", "period_ms"],
              "properties": {
                "can_id": { "type": "integer", "minimum": 0 },
                "data": { "type": "string" },
                "period_ms": { "type": "integer", "minimum": 1 },
                "dlc": { "type": "integer", "minimum": 0, "maximum": 64 },
                "is_eff": { "type": "boolean" },
                "is_fd": { "type": "boolean" },
                "brs": { "type": "boolean" }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["job_id"],
              "properties": {
                "job_id": { "type": "string" }
              }
            }
          }
        },
        "tx.cyclic.stop": {
          "description": "Stop a cyclic transmit job. Not implemented in T2.",
          "type": "object",
          "properties": {
            "direction": { "const": "request-response" },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["job_id"],
              "properties": {
                "job_id": { "type": "string" }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok"],
              "properties": {
                "ok": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
