{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "./out/tsconfig-node"
  },
  "include": [
    "electron/main/**/*",
    "electron/preload/**/*",
    "scripts/test-preload-bridge.ts",
    "scripts/test-bus-bridge.ts",
    "scripts/test-rx-bridge.ts",
    "scripts/test-dbc-bridge.ts",
    "scripts/test-dbc-browse.ts",
    "scripts/test-trace.ts",
    "scripts/test-graph.ts",
    "scripts/test-tx-bridge.ts",
    "scripts/test-smoke.ts",
    "scripts/test-persist.ts",
    "scripts/test-engine-paths.ts",
    "scripts/test-app-icon.ts",
    "electron.vite.config.ts"
  ],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
